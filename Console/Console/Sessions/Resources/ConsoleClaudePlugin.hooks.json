            "command" : "\"$CONSOLE_TERM_BRIDGE_HELPER\" hook CwdChanged"
          }
        ]
      }
    ],
    "Notification" : [
      {
        "matcher" : "idle_prompt",
        "hooks" : [
          {
            "type" : "command",
            "async" : true,
            "command" : "\"$CONSOLE_TERM_BRIDGE_HELPER\" hook NotificationIdlePrompt"
          }
        ]
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "type" : "command",
            "async" : true,
            "command" : "\"$CONSOLE_TERM_BRIDGE_HELPER\" hook PermissionRequest"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "matcher" : "AskUserQuestion",
        "hooks" : [
          {
            "type" : "command",
            "async" : true,
            "command" : "\"$CONSOLE_TERM_BRIDGE_HELPER\" hook AskUserQuestion"
          }
